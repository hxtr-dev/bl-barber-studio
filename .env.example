# Banco Neon (Postgres). No painel do Neon: Connect > copie a "Pooled connection".
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Endereço público do site (sem barra no final). Usado no retorno do pagamento e no webhook.
SITE_URL="https://blbarberstudio.com.br"

# Painel do ADM
ADMIN_PASSWORD="troque-esta-senha"
# Texto longo e aleatório para assinar o login do ADM (ex.: openssl rand -hex 32)
ADMIN_SECRET="troque-por-um-texto-aleatorio-bem-longo"

# InfinitePay (Checkout Integrado). InfiniteTag sem o $.
INFINITEPAY_HANDLE="suainfinitetag"
# Opcional: chave da API (começa com inchk_). Não é obrigatória.
INFINITEPAY_API_KEY=""

# "pix" mostra o QR code no próprio site (Biel confirma no painel). "real" usa a página da InfinitePay. "teste" simula o pagamento (nunca use no ar).
PAYMENT_MODE="real"

# Pix no próprio site (PAYMENT_MODE="pix"): chave Pix do Biel.
# CPF/CNPJ só números; celular no formato +5511999999999; e-mail; ou chave aleatória.
PIX_KEY=""
# Nome do recebedor (até 25 letras, sem acento) e cidade (até 15)
PIX_NAME="BL Barber Studio"
PIX_CITY="Carapicuiba"
